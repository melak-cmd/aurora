<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta name="theme-color" content="#f6f7f9" />
  <title>Object library</title>
  <style>
    :root {
      color-scheme: light;
      --ink: #18211f;
      --muted: #687572;
      --line: #e4e9e6;
      --green: #176b50;
      --green-dark: #10543e;
      --paper: #fff;
      --canvas: #f6f7f5;
      --shadow: 0 12px 32px rgba(23, 41, 34, .06);
    }
    * { box-sizing: border-box; }
    body { margin: 0; background: var(--canvas); color: var(--ink); font: 15px/1.5 Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif; }
    button, input { font: inherit; }
    .shell { width: min(1040px, calc(100% - 40px)); margin: 0 auto; padding: 62px 0 80px; }
    .eyebrow { display: flex; align-items: center; gap: 9px; margin: 0 0 12px; color: var(--green); font-size: .75rem; font-weight: 750; letter-spacing: .12em; text-transform: uppercase; }
    .eyebrow::before { content: ""; width: 8px; height: 8px; border-radius: 50%; background: #54a982; box-shadow: 0 0 0 4px #e2f1e9; }
    h1 { margin: 0; font-size: clamp(2.2rem, 5vw, 3.4rem); letter-spacing: -.055em; line-height: 1.08; }
    .intro { max-width: 520px; margin: 15px 0 30px; color: var(--muted); font-size: 1.04rem; }
    .toolbar { display: flex; gap: 12px; align-items: center; padding: 14px; background: var(--paper); border: 1px solid var(--line); border-radius: 14px; box-shadow: var(--shadow); }
    .search-wrap { position: relative; flex: 1; }
    .search-icon { position: absolute; left: 14px; top: 50%; color: #798681; transform: translateY(-50%); pointer-events: none; }
    #search { width: 100%; min-height: 46px; padding: 0 14px 0 42px; color: var(--ink); background: #f8faf9; border: 1px solid transparent; border-radius: 9px; outline: none; transition: border .2s, box-shadow .2s; }
    #search:focus { border-color: #83b7a0; box-shadow: 0 0 0 3px #e5f2eb; }
    #refresh-btn { min-height: 46px; padding: 0 17px; color: white; background: var(--green); border: 0; border-radius: 9px; font-weight: 650; cursor: pointer; transition: background .2s, transform .2s; }
    #refresh-btn:hover { background: var(--green-dark); transform: translateY(-1px); }
    #refresh-btn:disabled { opacity: .65; cursor: wait; transform: none; }
    .results-head { display: flex; justify-content: space-between; align-items: center; margin: 30px 2px 14px; }
    .results-head h2 { margin: 0; font-size: 1rem; letter-spacing: -.01em; }
    #result-count { color: var(--muted); font-size: .88rem; }
    #objects-list { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 14px; margin: 0; padding: 0; list-style: none; }
    .object-card { min-width: 0; padding: 21px; background: var(--paper); border: 1px solid var(--line); border-radius: 13px; box-shadow: 0 3px 12px rgba(23, 41, 34, .025); cursor: pointer; transition: transform .18s, box-shadow .18s, border-color .18s; }
    .object-card:hover, .object-card:focus-visible { border-color: #b7d3c4; box-shadow: var(--shadow); transform: translateY(-2px); outline: none; }
    .card-top { display: flex; justify-content: space-between; align-items: center; gap: 12px; }
    .object-id { color: var(--muted); font: 500 .76rem/1.4 ui-monospace, SFMono-Regular, Menlo, monospace; overflow-wrap: anywhere; }
    .swatch { width: 13px; height: 13px; flex: 0 0 13px; border: 1px solid rgba(0,0,0,.12); border-radius: 50%; }
    .object-name { margin: 13px 0 0; font-size: 1.15rem; letter-spacing: -.025em; overflow-wrap: anywhere; }
    .object-data { margin-top: 12px; color: var(--muted); font-size: .88rem; }
    .object-data .data-row { display: flex; gap: 6px; padding-top: 5px; }
    .data-key { color: #46534f; font-weight: 650; }
    .data-value { min-width: 0; overflow-wrap: anywhere; }
    .state { grid-column: 1 / -1; padding: 42px 20px; color: var(--muted); background: var(--paper); border: 1px dashed #d7dfda; border-radius: 13px; text-align: center; }
    .state strong { display: block; margin-bottom: 4px; color: var(--ink); font-size: 1rem; }
    .state.error { color: #a33b32; background: #fff9f8; border-color: #efd3cf; }
    .modal { display: none; position: fixed; z-index: 5; inset: 0; align-items: center; justify-content: center; padding: 20px; background: rgba(18, 30, 25, .48); backdrop-filter: blur(4px); }
    .modal.open { display: flex; }
    .modal-content { width: min(500px, 100%); max-height: min(80vh, 680px); overflow: auto; padding: 26px; background: var(--paper); border: 1px solid rgba(255,255,255,.5); border-radius: 16px; box-shadow: 0 24px 70px rgba(0,0,0,.22); animation: appear .18s ease-out; }
    @keyframes appear { from { opacity: 0; transform: translateY(8px) scale(.985); } to { opacity: 1; transform: none; } }
    .modal-top { display: flex; justify-content: space-between; align-items: flex-start; gap: 14px; }
    #modal-name { margin: 0; font-size: 1.5rem; letter-spacing: -.04em; }
    #modal-id { margin: 5px 0 20px; color: var(--muted); font: .8rem ui-monospace, SFMono-Regular, Menlo, monospace; }
    .close-btn { width: 36px; height: 36px; flex: 0 0 36px; color: #53615b; background: #f1f4f2; border: 0; border-radius: 9px; font-size: 1.35rem; cursor: pointer; }
    #modal-data .data-row { display: grid; grid-template-columns: minmax(90px, 1fr) 2fr; gap: 14px; padding: 11px 0; border-top: 1px solid var(--line); }
    #modal-data .data-value { text-align: right; }
    @media (max-width: 640px) { .shell { width: min(100% - 28px, 520px); padding-top: 40px; } .toolbar { align-items: stretch; flex-direction: column; } #objects-list { grid-template-columns: 1fr; } #refresh-btn { width: 100%; } }
    @media (prefers-reduced-motion: reduce) { *, *::before, *::after { scroll-behavior: auto !important; animation-duration: .01ms !important; transition-duration: .01ms !important; } }
  </style>
</head>
<body>
  <main class="shell">
    <p class="eyebrow">Connected collection</p>
    <h1>Object library</h1>
    <p class="intro">Browse the objects in your collection. Search by name, ID, or any of their properties.</p>
    <div class="toolbar">
      <label class="search-wrap">
        <span class="search-icon" aria-hidden="true">⌕</span>
        <input id="search" type="search" placeholder="Search objects…" aria-label="Search objects" autocomplete="off" />
      </label>
      <button id="refresh-btn" type="button">↻ &nbsp;Refresh</button>
    </div>
    <div class="results-head"><h2>All objects</h2><span id="result-count" aria-live="polite"></span></div>
    <ul id="objects-list" aria-label="Objects" aria-live="polite"></ul>
  </main>
  <div id="item-modal" class="modal" role="presentation">
    <section class="modal-content" role="dialog" aria-modal="true" aria-labelledby="modal-name" aria-describedby="modal-id">
      <div class="modal-top">
        <div><h2 id="modal-name"></h2><p id="modal-id"></p></div>
        <button class="close-btn" id="close-modal" type="button" aria-label="Close details">×</button>
      </div>
      <div id="modal-data"></div>
    </section>
  </div>
  <script src="/script.js"></script>
</body>
</html>
